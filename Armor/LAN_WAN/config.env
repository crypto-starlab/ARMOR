# Shared defaults for single-host LAN/WAN experiments (both links shaped).
KEYCENTER_HOST=${KEYCENTER_HOST:-10.203.77.1}
SERVER1_HOST=${SERVER1_HOST:-10.203.78.1}
SERVER2_HOST=${SERVER2_HOST:-10.203.77.2}
KEYCENTER_BIND=${KEYCENTER_BIND:-$KEYCENTER_HOST}
SERVER1_BIND=${SERVER1_BIND:-$SERVER1_HOST}
SERVER2_BIND=${SERVER2_BIND:-$SERVER2_HOST}
KEYCENTER_PORT=${KEYCENTER_PORT:-9100}
SERVER1_PORT=${SERVER1_PORT:-9101}
SERVER2_PORT=${SERVER2_PORT:-9102}
CONNECT_TIMEOUT=${CONNECT_TIMEOUT:-600}
KEYCENTER_GPU=${KEYCENTER_GPU:-0}
SERVER1_GPU=${SERVER1_GPU:-0}
SERVER2_GPU=${SERVER2_GPU:-0}
CLIENT_GPU=${CLIENT_GPU:-0}
DATASET=${DATASET:-MNIST}
NUM_CLIENTS=${NUM_CLIENTS:-3}
GLOBAL_EP=${GLOBAL_EP:-2}
LOCAL_EP=${LOCAL_EP:-1}
LOCAL_BS=${LOCAL_BS:-32}
ATTACK=${ATTACK:-No_Attack}
ATTACK_RATIO=${ATTACK_RATIO:-0}
ATTACK_TIME=${ATTACK_TIME:-0}

SEED=${SEED:-2023}
RUN_TAG=${RUN_TAG:-${profile}_rep1}
